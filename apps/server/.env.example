# Local Docker database only. Use separate credentials in deployment.
DATABASE_URL=postgresql://sangat:sangat_local_only@localhost:5432/sangat?schema=public
TEST_DATABASE_URL=postgresql://sangat:sangat_local_only@localhost:5432/sangat_test?schema=public
# npm run setup:env generates this securely; never commit apps/server/.env.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEB_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
# Set only when behind a known reverse proxy; see README.
TRUST_PROXY_HOPS=0
