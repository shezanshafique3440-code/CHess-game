generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum GameStatus {
  WAITING
  ACTIVE
  COMPLETED
  ABORTED
}
enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
}
enum ResultReason {
  CHECKMATE
  STALEMATE
  RESIGNATION
  AGREEMENT
  THREEFOLD_REPETITION
  INSUFFICIENT_MATERIAL
  FIFTY_MOVE_RULE
  TIMEOUT
  ABORTED
}
model User {
  id            String   @id @default(uuid()) @db.Uuid
  username      String   @unique @db.VarChar(24)
  email         String?  @unique @db.VarChar(254)
  passwordHash  String?
  rating        Int      @default(1200)
  createdAt     DateTime @default(now())
  isGuest       Boolean  @default(false)
  expiresAt     DateTime?
  authVersion   Int      @default(0)
  whiteGames    Game[]   @relation("WhitePlayer")
  blackGames    Game[]   @relation("BlackPlayer")
  @@index([isGuest, expiresAt])
}
model Game {
  id                String        @id @default(uuid()) @db.Uuid
  whiteId           String        @db.Uuid
  blackId           String        @db.Uuid
  white             User          @relation("WhitePlayer", fields: [whiteId], references: [id], onDelete: Restrict)
  black             User          @relation("BlackPlayer", fields: [blackId], references: [id], onDelete: Restrict)
  timeControl       String        @db.VarChar(16)
  status            GameStatus    @default(WAITING)
  result            GameResult?
  resultReason      ResultReason?
  pgn               String        @default("")
  finalFen          String?
  whiteRatingBefore Int
  whiteRatingAfter  Int?
  blackRatingBefore Int
  blackRatingAfter  Int?
  startedAt         DateTime?
  endedAt           DateTime?
  moves             Move[]
  @@index([whiteId, startedAt])
  @@index([blackId, startedAt])
  @@index([status])
}
model Move {
  id         String @id @default(uuid()) @db.Uuid
  gameId     String @db.Uuid
  game       Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ply        Int
  san        String @db.VarChar(16)
  fen        String
  timeLeftMs Int
  @@unique([gameId, ply])
}
