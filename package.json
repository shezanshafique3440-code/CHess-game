{
  "name": "sangat-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,server \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm run dev --workspace @sangat/web",
    "dev:server": "npm run dev --workspace @sangat/server",
    "build": "npm run build --workspaces",
    "preview": "npm run preview --workspace @sangat/web",
    "test": "npm run test:web && npm run test:server",
    "test:web": "npm test --workspace @sangat/web",
    "test:server": "npm test --workspace @sangat/server",
    "test:e2e": "npm run test:e2e --workspace @sangat/web",
    "db:generate": "npm run db:generate --workspace @sangat/server",
    "db:migrate": "npm run db:migrate --workspace @sangat/server",
    "setup:env": "node scripts/setup-env.mjs",
    "postinstall": "npm run db:generate && node apps/web/scripts/copy-engine.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:auth:e2e": "npm run test:auth:e2e --workspace @sangat/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.10.1"
  }
}
